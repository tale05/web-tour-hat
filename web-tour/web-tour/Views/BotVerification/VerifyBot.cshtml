@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Yêu cầu xác minh</title>
    <link rel="icon" type="image/png" href="~/images/icon_head.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/home/verify-style.css" rel="stylesheet" />
</head>
<body>
    <div class="verify-container">
        <img src="~/system/icon/logo_HAT-removebg-preview.png" alt="Logo HAT" class="logo" />
        <h2>Vui lòng xác minh bạn không phải robot</h2>
        <p class="note">Hệ thống cần xác nhận để tiếp tục.</p>

        <form method="post" asp-action="VerifyBot">
            <input type="hidden" id="g-recaptcha-response" name="gRecaptchaResponse" />
            <button type="submit" class="btn btn-primary">Xác minh</button>
        </form>
    </div>

    <script src="https://www.google.com/recaptcha/api.js?render=6Ld1flcrAAAAAGGSPvlEnvC3GrTy_-1eq6TtnM_N"></script>
    <script>
        grecaptcha.ready(function () {
            grecaptcha.execute('6Ld1flcrAAAAAGGSPvlEnvC3GrTy_-1eq6TtnM_N', { action: 'submit' }).then(function (token) {
                document.getElementById('g-recaptcha-response').value = token;
            });
        });
    </script>
</body>
</html>