<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Dashboard || Nhân Viên</title>
    <link rel="icon" type="image/png" href="~/images/icon_head.png" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"> *@
    <link rel="stylesheet" href="~/css/loading-spinner.css" />
    <link rel="stylesheet" href="~/css/employee/dashboardlayout.css" />
</head>
<body>
    @await Html.PartialAsync("_LoadingSpinner")
    @await Html.PartialAsync("_NotificationPartial")
    <div class="app-container">
        <!-- Sidebar -->
        <div class="sidebar">
            @await Html.PartialAsync("NavbarDashboardPartial")
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Header -->
            <header class="header-for-dashboard__DashboardLayout">
                <div class="header-left-for-dashboard__DashboardLayout">
                    <h1>Dashboard</h1>
                    <p class="date">@DateTime.Now.ToString("dd/MM/yyyy HH:MM")</p>
                </div>
                <div class="header-right-for-dashboard__DashboardLayout">
                    <div class="header-right-for-dashboard__DashboardLayout--avatar">
                        @if (ViewBag.Avatar != null)
                        {
                            <img src="@Url.Content(ViewBag.Avatar)" alt="Avatar" />
                        }
                        else
                        {
                            <img src="~/images/userLogin.png" alt="Avatar" />
                        }
                        <h2>
                            @if (ViewBag.NameEmployee != null)
                            {
                                <span>@ViewBag.NameEmployee</span>
                            }
                        </h2>
                    </div>
                    <div class="header-right-for-dashboard__DashboardLayout--logout">
                        <a href="@Url.Action("Logout", "Account")">Thông tin tài khoản</a>
                    </div>
                </div>
            </header>

            <!-- Dashboard Content -->
            <main class="dashboard">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="https://kit.fontawesome.com/a076d05399.js"></script>
    <script src="~/js/loading-spinner.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('input, textarea').forEach(function (el) {
                el.setAttribute('spellcheck', 'false');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>