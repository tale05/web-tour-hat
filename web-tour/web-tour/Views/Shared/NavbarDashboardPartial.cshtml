            </a>
        </div>

        <ul class="menu">
                @* <li class="@(currentAction == "Dashboard" && currentController == "Employee" ? "active" : "")">
                <a href="@Url.Action("Dashboard", "Employee")">
                    <i class="fas fa-home"></i>
                    Trang chủ
                </a>
            </li> *@

            <li class="@(currentAction == "CompanyInfo" && currentController == "Employee" ? "active" : "")">
                <a href="@Url.Action("CompanyInfo", "Employee")">
                    <i class="fas fa-globe"></i>
                    Thông tin công ty
                </a>
            </li>

            <li class="@(currentAction == "CategoryManagement" && currentController == "Employee" ? "active" : "")">
