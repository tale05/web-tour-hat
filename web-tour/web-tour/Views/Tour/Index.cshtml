@using web_tour.Helpers
@model web_tour.Models.AllListViewModelsForIndexPage
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Danh sách tour";

    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentSlug = ViewContext.RouteData.Values["slug"]?.ToString(); // null nếu là Index
}
@section Styles {
    <link href="~/css/security-block.css" rel="stylesheet" />
    <link href="~/css/tour/indextour.css" rel="stylesheet" />
}

<div class="application-section__HomeIndex">
    @foreach (var item in Model.ListNameAndImageCategories)
    {
        <a href="@Url.Action("GetListTourByCategory", "Tour", new { slug = SlugHelper.GenerateSlug(item.NameCategory) })">
            <div class="application-card__HomeIndex">
                <img src="@item.ImgCategory" alt="Sports Performance" />
                <div class="overlay__HomeIndex">
                    <h2>@item.NameCategory</h2>
                </div>
            </div>
        </a>
    }
</div>

@if (!Model.ListTourForIndex.Any())
{
    <div class="tour-notification-empty__TourIndex">
        😢 Không có tour du lịch nào cần tìm kiếm.
    </div>
}
else
{
    <div class="tour-index-wrapper__TourIndex">
        <div class="container-tours__TourIndex">
            <h1 class="section-title__TourIndex">Tất cả tour du lịch</h1>
            @foreach (var item in Model.ListTourForIndex)
            {
                <div class="tour-card__TourIndex">
                    @{
                        var slug = SlugHelper.GenerateSlug(item.NameTour);
                    }
                    <a href="@Url.Action("TourDetail", "Tour", new { slug = slug })" class="tour-card-link">
                        <div class="tour-card-image__TourIndex">
                            <img src="@item.ImgTour" alt="@item.NameTour" />
                            <div class="tour-card-overlay__TourIndex">
                                <span class="view-details__TourIndex">Xem Chi Tiết</span>
                            </div>
                        </div>
                        <div class="tour-card-content__TourIndex">
                            <h3 class="tour-title__TourIndex">
                                <i class="fa-solid fa-location-dot"></i> @item.NameTour
                            </h3>
                            <p class="tour-price__TourIndex">
                                <span class="price-before__TourIndex">Giá gốc: @item.PriceBefore</span>
                                <span class="price-after__TourIndex">
                                    <i class="fa-solid fa-tag"></i> @item.PriceAfter
                                </span>
                            </p>
                            <p style="font-style: italic; color: #666; font-size: 12px; letter-spacing: 0.5px; font-weight: 500; margin: 0 0 10px 0; text-align: center;">
                                © Bản quyền thuộc về Công ty Du lịch H.A.T
                            </p>
                        </div>
                    </a>
                </div>
            }
        </div>

        <div class="container-list-category__TourIndex">
            <p>Danh mục</p>

            <a href="@Url.Action("Index", "Tour")"
               class="@(currentAction == "Index" ? "active" : "")">
                Tất cả
            </a>

            @foreach (var item in Model.ListNameAndImageCategories)
            {
                var slug = SlugHelper.GenerateSlug(item.NameCategory);
                <a href="@Url.Action("GetListTourByCategory", "Tour", new { slug = slug })"
                   class="@(currentAction == "GetListTourByCategory" && currentSlug == slug ? "active" : "")">
                    @item.NameCategory
                </a>
            }
        </div>
    </div>
}

@{
    var categoryId = ViewBag.CategoryId as string;
    var actionName = string.IsNullOrEmpty(categoryId) ? "Index" : "GetListTourByCategory";
}

<div class="pagination__TourIndex">
    @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
    {
        <a href="@Url.Action(actionName, "Tour", new { id = categoryId, page = i })"
           class="@(i == (int)ViewBag.CurrentPage ? "active-page__TourIndex" : "")">
            @i
        </a>
    }
</div>

@* @if (Model.ListTourRecentlyViewed != null && Model.ListTourRecentlyViewed.Any())
{
    <div class="main-content-recently-viewed__TourIndex">
        <p>Xem gần đây</p>
        <div class="container-recently-viewed__TourIndex" id="recent-tour-container">
