@model List<web_tour.Models.CategoryModel>
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Quản lý danh mục";
}

<link href="~/css/employee/categorymanagement.css" rel="stylesheet" />
<link href="~/css/notification.css" rel="stylesheet" />

<div class="container-category-management">
    <h1>Quản lý danh mục</h1>

    <div class="text-end w-100 mb-3">
        <a href="@Url.Action("CategoryInsert", "Employee")" class="btn btn-primary" id="add-category-btn" style="border-radius:20px; text-decoration:none">Thêm danh mục</a>
    </div>

    <br />
    @if (Model == null)
    {
        <h2 style="padding: 30px 0 0 0px; color:orangered">
            Chưa có dữ liệu
        </h2>
    }
    else
    {
        <h3 style="padding: 15px 0; color:orangered">
            Tổng số danh mục hiện có là: @Model.Count
        </h3>
        <table class="table table-hover table-bordered align-middle text-center">
            <thead class="table-dark">
                <tr>
                    <th>Id danh mục</th>
                    <th>Tên danh mục</th>
                    <th>Ảnh danh mục</th>
                    <th>Trạng thái</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CategoryId</td>
                        <td>@item.NameCategory</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImgCategory))
                            {
                                <img src="@item.ImgCategory"
                                     alt="Ảnh danh mục"
                                     style="max-height:60px;"
                                     class="img-thumbnail"
                                     onerror="this.onerror=null; this.src='@Url.Content("~/images/empty.png")';" />
                            }
                            else
                            {
                                <em>Không có ảnh</em>
                            }
                        </td>
                        <td>
                            @if (item.StatusCategory == true)
                            {
                                <span class="badge bg-success" style="width: 120px">Đang hiển thị</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary" style="width: 120px">Đã ẩn</span>
                            }
                        </td>
                        <td class="text-center">
                            <a href="@Url.Action("EditCategory", "Employee", new { id = item.CategoryId })"
                               class="button-edit-Category">
                                <i class="fas fa-edit"></i> Chỉnh sửa
                            </a>

                            @if (item.StatusCategory == true)
                            {
                                <form method="post" action="@Url.Action("UpdateCategoryStatus", "Employee")" style="display:inline;">
                                    <input type="hidden" name="categoryId" value="@item.CategoryId" />
                                    <input type="hidden" name="imgCategory" value="@item.ImgCategory" />
                                    <input type="hidden" name="status" value="false" />
                                    <button type="submit" class="toggle-button-showHideCategory">
                                        <i class="fas fa-eye-slash"></i> Ẩn
                                    </button>
                                    @await Html.PartialAsync("_NotificationPartial")
                                </form>
                            }
                            else
                            {
                                <form method="post" action="@Url.Action("UpdateCategoryStatus", "Employee")" style="display:inline;">
                                    <input type="hidden" name="categoryId" value="@item.CategoryId" />
                                    <input type="hidden" name="imgCategory" value="@item.ImgCategory" />
                                    <input type="hidden" name="status" value="true" />
                                    <button type="submit" class="toggle-button-showHideCategory">
                                        <i class="fas fa-eye"></i> Hiện
                                    </button>
                                    @await Html.PartialAsync("_NotificationPartial")
                                </form>
                            }

                            <a href="@Url.Action("RemoveCategory", "Employee", new { id = item.CategoryId })"
                               class="button-remove-Category"
                               onclick="return confirm('Bạn có chắc chắn muốn xoá danh mục này không?');">
                                <i class="fas fa-trash-alt"></i> Xoá
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>


<script src="~/js/notification.js"></script>
<script>
    @if (TempData["Error"] != null)
    {
        <text> showNotification('error', '@TempData["Error"]'); </text>
    }
    else if (TempData["Success"] != null)
    {
        <text> showNotification('success', '@TempData["Success"]'); </text>
    }
</script>