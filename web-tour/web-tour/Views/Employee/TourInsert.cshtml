@model web_tour.Models.TourInsertViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Thêm tour mới";
}
<link href="~/css/employee/tourinsert.css" rel="stylesheet" />
<link href="~/css/notification.css" rel="stylesheet" />

<div class="tour-insert-container__TourManagement_cshtml">
    <h2 class="tour-insert-title__TourManagement_cshtml">Thêm thông tin tour mới</h2>

    <form asp-action="AddTour" asp-controller="Employee" method="post" enctype="multipart/form-data">
        <div class="form-group__TourManagement_cshtml">
            <label>Danh mục</label>
            <select asp-for="CategoryId" class="form-control__TourManagement_cshtml" required>
                <option value="">-- Chọn danh mục --</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.CategoryId">@category.NameCategory</option>
                }
            </select>
        </div>

        <div class="form-group__TourManagement_cshtml">
            <label>Tiêu đề tour</label>
            <input asp-for="Title" class="form-control" required />
        </div>

        <div class="form-group__TourManagement_cshtml">
            <label>Ảnh tiêu đề</label>
            <input type="text"
                   id="ImgProduct"
                   name="ImgProduct"
                   class="form-control-file"
                   readonly="readonly"
                   required />
            <button type="button" onclick="openFileManager()">Click để mở form chọn ảnh</button>
            <img id="previewImage"
                 src=""
                 alt="Chưa có ảnh nào được chọn"
                 style="max-width: 600px; height: auto; display: none; border: 1px solid #ccc; padding: 5px;" />
        </div>

        <div class="form-group__TourManagement_cshtml form-check">
            <input asp-for="StatusProduct" class="form-check-input" checked />
            <label class="form-check-label">Đang hiển thị</label>
        </div>

        <button type="submit" class="btn btn-primary__TourManagement_cshtml">Thêm tour</button>
        <a href="@Url.Action("TourManagement", "Employee")" class="btn btn-secondary">Quay lại</a>
    </form>
</div>


@await Html.PartialAsync("_NotificationPartial")
<script src="~/js/notification.js"></script>
@section Scripts {
    <script>
        function openFileManager() {
            // Mở popup elFinder
            var width = 900;
            var height = 600;
            var left = (screen.width - width) / 2;
            var top = (screen.height - height) / 2;

            window.open(
                '/FileManager/SelectImage',
                'FileManager',
                'width=' + width + ',height=' + height + ',top=' + top + ',left=' + left
            );
        }

        // Nhận đường dẫn từ elFinder và hiển thị ảnh
        function SetImageUrl(url) {
        try {
                var relativeUrl = url;
                // Nếu url là dạng tuyệt đối, ví dụ: https://localhost:7231/files/tourmiennam.jpg
                var origin = window.location.origin;
                if (url.startsWith(origin)) {
                    relativeUrl = url.substring(origin.length);
                }
                document.getElementById('ImgProduct').value = relativeUrl;
                const img = document.getElementById('previewImage');
                img.src = relativeUrl;
                img.style.display = "block";
            } catch (e) {
                document.getElementById('ImgProduct').value = url;
                const img = document.getElementById('previewImage');
                img.src = url;
                img.style.display = "block";
            }
        }

        window.SetImageUrl = SetImageUrl;

        @if (ViewData["Error"] != null)
        {
            <text> showNotification('error', '@ViewData["Error"]'); </text>
        }
        else if (TempData["Success"] != null)
        {
            <text> showNotification('success', '@TempData["Success"]'); </text>
        }
    </script>
}