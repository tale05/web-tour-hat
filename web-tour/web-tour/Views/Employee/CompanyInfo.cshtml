@model web_tour.Models.Company.CompanyModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Thông tin công ty";
}
<link href="~/css/employee/companyinfo.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/notification.css" />
<div class="container-company-info">
    <h2>Quản lý thông tin công ty</h2>
    @using (Html.BeginForm("ChangeCompanyInfo", "Employee", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.HiddenFor(m => m.CompanyId)
        <table>
            <colgroup>
                <col />
                <col />
            </colgroup>
            <thead>
                <tr>
                    <th>Thuộc tính</th>
                    <th>Giá trị</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Id công ty (Hệ thống)</td>
                    <td>
                        @Html.TextBoxFor(m => m.CompanyId, new { @readonly = "readonly", @class = "readonly-input" })
                    </td>
                </tr>
                <tr>
                    <td>Tên công ty (VN)</td>
                    <td>@Html.TextBoxFor(m => m.NameVie)</td>
                </tr>
                <tr>
                    <td>Tên công ty (EN)</td>
                    <td>@Html.TextBoxFor(m => m.NameEng)</td>
                </tr>
                <tr>
                    <td>Tên viết tắt</td>
                    <td>@Html.TextBoxFor(m => m.NameAbbr)</td>
                </tr>
                <tr>
                    <td>Email công ty</td>
                    <td>@Html.TextBoxFor(m => m.CompanyEmail)</td>
                </tr>
                <tr>
                    <td>Số điện thoại</td>
                    <td>@Html.TextBoxFor(m => m.CompanyPhone)</td>
                </tr>
                <tr>
                    <td>Địa chỉ</td>
                    <td>@Html.TextBoxFor(m => m.CompanyAddress)</td>
                </tr>
                <tr>
                    <td>Số giấy phép kinh doanh</td>
                    <td>@Html.TextBoxFor(m => m.BusinessLicenseNo)</td>
                </tr>
                <tr>
                    <td>Ngày cấp GPKD</td>
                    <td>
                        @Html.TextBoxFor(m => m.BusinessLicenseDate, "{0:yyyy-MM-dd}", new { type = "date" })
                    </td>
                </tr>
                <tr>
                    <td>Nơi cấp GPKD</td>
                    <td>@Html.TextBoxFor(m => m.IssuedBy)</td>
                </tr>
                <tr>
                    <td>Số giấy phép lữ hành QT</td>
                    <td>@Html.TextBoxFor(m => m.InternationalTravelLicenseNo)</td>
                </tr>
                <tr>
                    <td>Ngày cấp GPLHQT</td>
                    <td>
                        @Html.TextBoxFor(m => m.InternationalTravelLicenseDate, "{0:yyyy-MM-dd}", new { type = "date" })
                    </td>
                </tr>
                <tr>
                    <td>Facebook</td>
                    <td>@Html.TextBoxFor(m => m.FacebookUrl)</td>
                </tr>
                <tr>
                    <td>Mô tả công ty</td>
                    <td>
                        @Html.TextAreaFor(
                                 m => m.CompanyDescription,
                                 new
                                 {
                                     id = "input-Description__companyInfo",
                                 })
                    </td>
                </tr>
            </tbody>
        </table>
        <button type="submit">Lưu thông tin</button>
    }
    @await Html.PartialAsync("_NotificationPartial")
</div>

<script src="https://cdn.tiny.cloud/1/iz8q6xcbgibchqldkhb6kbg9syrm3vb1q77ts1c280qm9p6m/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>
<script src="~/js/notification.js"></script>
<script>
    tinymce.init({
        selector: '#input-Description__companyInfo',
        plugins: [
            'paste', // <== thêm dòng này
            'anchor', 'autolink', 'charmap', 'codesample', 'emoticons',
            'image', 'link', 'lists', 'media', 'searchreplace',
            'table', 'visualblocks', 'wordcount'
        ],
        paste_as_text: false, // Cho phép giữ định dạng khi dán
        paste_data_images: true, // Cho phép dán cả ảnh từ clipboard (nếu cần)
        toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
        content_style: "body { font-family:Helvetica,Arial,sans-serif; font-size:14px }"
    });

    @if (TempData["Error"] != null)
    {
        <text> showNotification('error', '@TempData["Error"]'); </text>
    }
    else if (TempData["Success"] != null)
    {
        <text> showNotification('success', '@TempData["Success"]'); </text>
    }
</script>
